# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Session 签名密钥（生产环境务必改为长随机字符串）
SESSION_SECRET=please-change-this-to-a-long-random-string

# ===== Git-based CMS：后台保存时 commit 回 GitHub =====
# 在 GitHub Settings → Developer settings → Personal access tokens 里生成
# 需要 Contents: Read and write 权限
GITHUB_TOKEN=
# 例如：kakins（你自己的 GitHub 用户名或组织名）
GITHUB_OWNER=
# 例如：kakins-blog
GITHUB_REPO=
GITHUB_BRANCH=main
# commit 时显示的作者
GITHUB_COMMITTER_NAME=Kakin Studio Bot
GITHUB_COMMITTER_EMAIL=bot@kakin.studio

# ===== SSH 自动部署（配合 GitHub Actions 方案 B）=====
# DEPLOY_HOST=your-server-ip
# DEPLOY_USER=root
# DEPLOY_PORT=22
# DEPLOY_PATH=~/kakins-blog
