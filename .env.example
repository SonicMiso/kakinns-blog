# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Session 签名密钥（生产环境务必改为长随机字符串）
SESSION_SECRET=please-change-this-to-a-long-random-string

# ===== Git-based CMS：后台保存时 commit 回 GitHub =====
# 在 GitHub Settings → Developer settings → Personal access tokens 里生成
# 需要 Contents: Read and write 权限
GITHUB_TOKEN=
# 例如：kakins（你自己的 GitHub 用户名或组织名）
GITHUB_OWNER=
# 例如：kakins-blog
GITHUB_REPO=
GITHUB_BRANCH=main
# commit 时显示的作者
GITHUB_COMMITTER_NAME=Kakin Studio Bot
GITHUB_COMMITTER_EMAIL=bot@kakin.studio

# ===== 国内服务器网络加速 =====
# 1) 构建期 npm 源：默认 npmmirror（淘宝源）。有自建/内网源再覆盖。
NPM_REGISTRY=https://registry.npmmirror.com

# 2) GitHub API 反代。国内服务器直连 api.github.com 经常超时，二选一：
#    公开 ghproxy：https://ghproxy.com/https://api.github.com
#    自建 fastgithub：https://<你的fastgithub域名>/api
GITHUB_API_BASE=

# 3) 如果你在服务器上跑了 Clash/v2raya/Proxifier（宿主机 7890 端口）：
# HTTP_PROXY=http://172.17.0.1:7890
# HTTPS_PROXY=http://172.17.0.1:7890

# ===== SSH 自动部署（配合 GitHub Actions 方案 B）=====
# DEPLOY_HOST=your-server-ip
# DEPLOY_USER=root
# DEPLOY_PORT=22
# DEPLOY_PATH=~/kakins-blog
